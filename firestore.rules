rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 관리자 확인 (이메일 기반 하드코딩)
    // 보안을 위해 추후 Custom Claims 또는 admins 컬렉션으로 분리 가능
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'timbach@naver.com';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 결제/멤버십 상태는 관리자(또는 Admin SDK로 동작하는 서버)만 바꿀 수 있어야 함.
    // 클라이언트가 이 필드들을 직접 써넣으면 결제 없이 프리미엄으로 자가 승급이 가능해짐.
    function protectedUserFields() {
      return ['isPremium', 'membershipType', 'status', 'payments', 'totalScans'];
    }

    // 1. users 컬렉션
    match /users/{userId} {
      // 읽기: 본인 또는 관리자
      allow read: if isOwner(userId) || isAdmin();

      // 생성: 본인이 최초 가입 시 생성. 결제/등급 관련 필드는 이 시점에도 넣을 수 없게 차단.
      allow create: if isOwner(userId) &&
        !request.resource.data.keys().hasAny(protectedUserFields());

      // 수정: 본인은 프로필성 필드만 변경 가능(결제/등급 필드는 변경 불가), 관리자는 전체 허용.
      allow update: if isAdmin() ||
        (isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFields()));

      allow delete: if isAdmin();
    }

    // 2. feedbacks 컬렉션
    match /feedbacks/{feedbackId} {
      // 읽기: 본인 또는 관리자
      // list 등 전체 쿼리는 관리자만 가능, 본인 조회는 resource 확인 필요하므로
      // 앱 내 피드백 기능이 본인 목록 조회가 없다면 단순 등록(create)만 개방
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 3. payments 컬렉션
    // 실제 결제 기록은 결제 검증을 거친 서버(Cloud Functions, Admin SDK)에서만 써야 함.
    // Admin SDK는 보안 규칙을 우회하므로 여기서 클라이언트 쓰기를 막아도 정상 결제 플로우엔 영향 없음.
    // 클라이언트가 직접 create 가능하면 실제 결제 없이 완료된 결제 기록을 조작해 넣을 수 있음.
    match /payments/{paymentId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // 4. community_posts 컬렉션
    match /community_posts/{postId} {
      allow read: if true; // 누구나 읽기 가능 (혹은 isAuthenticated()로 제한 가능)
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      // 작성자 본인 또는 관리자만 수정/삭제 가능
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);

      // 4-1. comments 하위 컬렉션
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
      }
    }

    // 5. pets 컬렉션 (유저 반려동물 정보)
    match /pets/{petId} {
      // 본인의 반려동물 정보만 접근 가능
      allow read, write: if isAuthenticated() && (resource == null || resource.data.ownerId == request.auth.uid || request.resource.data.ownerId == request.auth.uid);
    }

    // 기타 (기본 거부)
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
